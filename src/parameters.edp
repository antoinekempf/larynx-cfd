real mu = 0.01;
real rho = 50.0;
int maxiter = 100;
real tol = 1e-6;

real dt = 0.01;
real Tmax = 10;

string testcase = "healthy";

if (ARGV.n > 2)
{
    testcase = ARGV[2];
}

cout << "Running testcase: " << testcase << endl;

string meshfile;
string outputfile;

if (testcase == "healthy")
{
    meshfile = "mesh/healthy.msh";
    outputfile = "output/healthy.vtu";
}
else if (testcase == "stenosis")
{
    meshfile = "mesh/stenosis.msh";
    outputfile = "output/stenosis.vtu";
}
else if (testcase == "larynx")
{
    meshfile = "mesh/larynx.msh";
    outputfile = "output/larynx.vtu";
}
else
{
    cout << "Unknown testcase." << endl;
    exit(1);
}
